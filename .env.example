# Copy to .env (or pass via --dart-define) for local development.
# The mobile app reads these via String.fromEnvironment in lib/core/config/env.dart.
# The Supabase anon key is publishable; Row Level Security is what protects data.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
